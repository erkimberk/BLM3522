# AWS IoT Core Configuration
AWS_REGION=eu-central-1
AWS_IOT_ENDPOINT=YOUR_IOT_ENDPOINT.iot.eu-central-1.amazonaws.com
AWS_IOT_THING_NAME=sensor-device-1

# IoT Certificates & Keys Path (relative to project root)
IOT_CERT_PATH=config/certificates/
IOT_CERT_FILE=device.crt
IOT_KEY_FILE=private.key
IOT_CA_FILE=AmazonRootCA1.pem

# MQTT Configuration
MQTT_BROKER=YOUR_IOT_ENDPOINT.iot.eu-central-1.amazonaws.com
MQTT_PORT=8883
MQTT_TOPIC_PREFIX=smart-city

# Sensor Configuration
SENSOR_UPDATE_INTERVAL=5  # seconds
TRAFFIC_LIGHT_ID=traffic-light-001
AIR_QUALITY_ID=air-quality-001
TRASH_BIN_ID=trash-bin-001

# Logging
LOG_LEVEL=INFO
